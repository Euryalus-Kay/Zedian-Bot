# Reddit API Credentials (https://www.reddit.com/prefs/apps)
REDDIT_CLIENT_ID=your_client_id
REDDIT_CLIENT_SECRET=your_client_secret
REDDIT_USER_AGENT=ViralStoryBot/1.0

# Anthropic Claude API Key
ANTHROPIC_API_KEY=your_anthropic_api_key

# YouTube OAuth (place client_secrets.json in project root)
# Get from Google Cloud Console -> APIs & Services -> Credentials
YOUTUBE_CLIENT_SECRETS=client_secrets.json

# Flask
FLASK_SECRET_KEY=change-this-to-a-random-string
FLASK_PORT=5000

# Cloudflare Tunnel (optional - for public access)
CLOUDFLARE_TUNNEL=false
